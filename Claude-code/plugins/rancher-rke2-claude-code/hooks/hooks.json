{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^mcp__rancher[-_]rke2__validate_config$",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/pre_mcp_config.py"],
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "^mcp__rancher[-_]rke2__(start_run|start_workflow)$",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/pre_mcp_mutation.py"],
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^mcp__rancher[-_]rke2__.*$",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/post_mcp_audit.py"],
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/verify_completion.py"],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
