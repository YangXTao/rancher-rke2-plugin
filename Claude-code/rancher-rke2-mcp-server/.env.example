# Public HTTPS listener. Port 8787 is not published by the MCP container.
MCP_HTTPS_BIND_ADDRESS=0.0.0.0
MCP_HTTPS_PORT=8443

# MCP container settings.
RANCHER_RKE2_MCP_HOST=0.0.0.0
RANCHER_RKE2_MCP_PORT=8787
RANCHER_RKE2_MCP_DB=/data/state.db
RANCHER_RKE2_MCP_LOG_LEVEL=INFO
RANCHER_RKE2_MCP_TOKEN_FILE=/run/secrets/mcp_bearer_token
