{
    "oom-score-adjust": -1000,
    "log-driver": "json-file",
{% if registry_insecure_skip_verify | bool %}
    "insecure-registries": ["0.0.0.0/0"],
{% else %}
    "insecure-registries": [],
{% endif %}
    "log-opts": {
        "max-size": "100m",
        "max-file": "3"
    },
    "max-concurrent-downloads": 10,
    "max-concurrent-uploads": 10,
{% if registry_enabled | bool %}
    "registry-mirrors": ["https://{{ registry_hostname }}"],
{% else %}
    "registry-mirrors": [],
{% endif %}
    "storage-driver": "overlay2",
    "storage-opts": [
        "overlay2.override_kernel_check=true"
    ]
}
